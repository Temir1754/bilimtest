# Образец настроек. Скопируйте этот файл в .env и впишите свои значения.
# Файл .env не попадает в git — ключи остаются только на вашем компьютере.
#
# Где взять значения (supabase.com → ваш проект):
#   URL проекта и publishable key — Project Settings → API Keys (и Data API для URL)
#   secret key                    — там же, раздел Secret keys (кнопка Reveal)
#   строка подключения к базе     — кнопка Connect вверху → Session pooler; вместо [YOUR-PASSWORD]
#                                   впишите пароль базы, который задали при создании проекта
# Если у вас ключи называются anon и service_role — это то же самое (старые названия):
#   anon = publishable, service_role = secret.

# ---------- Основной проект (bilimtest) ----------
# VITE_ в начале означает: значение попадёт в сайт и будет видно в браузере. Это нормально только для
# publishable/anon ключа — он и предназначен для браузера, доступ ограничивают правила RLS.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Для скриптов (миграции, импорт, назначение админа). Никогда не добавляйте VITE_ к этой строке!
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:ПАРОЛЬ@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres

# ---------- Тестовый проект (bilimtest-test) — только для npm run test:db ----------
# Тесты стирают данные этого проекта. Не вписывайте сюда основной проект!
TEST_SUPABASE_URL=https://yyyyyyyyyyyy.supabase.co
TEST_SUPABASE_PUBLISHABLE_KEY=sb_publishable_yyyyyyyy
TEST_SUPABASE_SECRET_KEY=sb_secret_yyyyyyyy
TEST_DB_URL=postgresql://postgres.yyyyyyyyyyyy:ПАРОЛЬ@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres

# ---------- Открытые данные data.egov.kz (справочник школ, DECISIONS.md №73) ----------
# Ключ API: data.egov.kz → войти (через eGov) → «Разработчикам» → «Кабинет разработчика» → создать ключ.
# Нужен только скрипту загрузки справочника школ, в сайт не попадает.
EGOV_API_KEY=
